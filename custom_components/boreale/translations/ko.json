{
  "config": {
    "flow_title": "{name}",
    "step": {
      "confirm": {
        "title": "PlayGuard 본체를 찾았습니다",
        "description": "**{name}**(본체 ID `{console_id}`)을(를) 추가할까요? 본체 자체의 Home Assistant 기기(MQTT 자동 검색)는 이 통합구성요소의 기기로 대체되며, 엔티티, 소프트웨어 이름, 이번 주 플레이 시간과 장기 통계는 그대로 유지됩니다."
      },
      "user": {
        "title": "PlayGuard 본체 추가",
        "description": "브로커에 상태가 있고 아직 설정되지 않은 본체입니다. 하나를 선택하거나, 다른 본체를 선택해 ID로 추가하세요.",
        "data": {
          "console": "본체"
        },
        "data_description": {
          "console": "이름과 ID, 그리고 토픽 접두사가 playguard가 아닐 때는 그 접두사."
        }
      },
      "manual": {
        "title": "ID로 PlayGuard 본체 추가",
        "description": "ID는 PlayGuard › 본체 › 원격 접속 › 본체 ID에 있습니다. 이후 통합구성요소가 브로커에서 본체 상태를 최대 10초 동안 기다립니다.",
        "data": {
          "console_id": "본체 ID",
          "topic_prefix": "토픽 접두사"
        },
        "data_description": {
          "console_id": "8자. 예: 5a0c3e11.",
          "topic_prefix": "sync.conf에서 따로 정하지 않았다면 playguard."
        }
      },
      "reconfigure": {
        "title": "토픽 접두사 변경",
        "description": "{name}이(가) 게시에 사용하는 접두사: PlayGuard의 sync.conf에 있는 `topic_prefix`입니다.",
        "data": {
          "topic_prefix": "토픽 접두사"
        },
        "data_description": {
          "topic_prefix": "sync.conf에서 따로 정하지 않았다면 playguard."
        }
      }
    },
    "error": {
      "invalid_console_id": "본체 ID는 0~9와 a~f로 된 8자입니다.",
      "invalid_prefix": "이 접두사는 MQTT 토픽에 사용할 수 없습니다.",
      "no_state": "이 본체는 이 접두사로 브로커에 아무것도 게시하지 않았습니다. 본체 ID와 접두사를 확인하고, 본체 연결이 한 번은 이루어졌는지 확인하세요(PlayGuard › 본체 › 원격 접속 › 상태)."
    },
    "abort": {
      "already_configured": "이 본체는 이미 설정되어 있습니다.",
      "invalid_discovery_info": "이 메시지는 PlayGuard 상태가 아닙니다.",
      "mqtt_not_ready": "MQTT 통합구성요소가 아직 설정되지 않았습니다. PlayGuard는 이를 통해 Home Assistant와 통신합니다. 본체와 같은 브로커로 먼저 설정하세요."
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "take_over_discovery": "본체 자체의 Home Assistant 기기 대체",
          "keep_values_asleep": "본체가 절전 중일 때 마지막 값 유지",
          "notify_refused": "나중에 거부된 명령 알림"
        },
        "data_description": {
          "take_over_discovery": "본체의 MQTT 자동 검색을 꺼서 엔티티가 두 번 나타나지 않게 합니다. 끄면: 본체가 다시 자체 기기를 게시합니다.",
          "keep_values_asleep": "본체가 브로커에 없는 동안(절전 모드, 전원 꺼짐, 연결 범위 밖) 엔티티는 본체가 마지막으로 보낸 값을 표시하고, 컨트롤에서 한 변경은 브로커에서 본체를 기다립니다. 끄면: 그동안 온라인을 제외한 모든 엔티티를 사용할 수 없습니다.",
          "notify_refused": "본체가 절전 중일 때 보낸 명령이나 PlayGuard의 확인을 기다리는 명령은 작업이 끝난 뒤에 응답을 받습니다. 이때 거부되면 알림이 표시되며, 다음 명령이 적용되면 사라집니다. 작업이 응답을 기다리는 동안(최대 10초) 거부되면 이 옵션과 관계없이 이유와 함께 작업이 실패합니다."
        }
      }
    }
  },
