  "services": {
    "set_limits": {
      "name": "Set the limits",
      "description": "Sets a day's limit, every day's, today's, or the whole week's (1440 = no limit).",
      "fields": {
        "device_id": {
          "name": "Console",
          "description": "The console."
        },
        "minutes": {
          "name": "Minutes",
          "description": "0 to 1440; 1440 means no limit."
        },
        "day": {
          "name": "Day",
          "description": "Which day."
        },
        "week": {
          "name": "Week",
          "description": "Seven limits, Sunday first, in place of minutes and day."
        }
      }
    },
    "add_bonus_time": {
      "name": "Add extra time",
      "description": "Extra minutes today; the usual limit comes back tomorrow.",
      "fields": {
        "device_id": {
          "name": "Console",
          "description": "The console."
        },
        "minutes": {
          "name": "Minutes",
          "description": "5 to 180."
        }
      }
    },
    "apply_profile": {
      "name": "Apply a profile",
      "description": "Applies the limits of a profile saved in PlayGuard.",
      "fields": {
        "device_id": {
          "name": "Console",
          "description": "The console."
        },
        "profile": {
          "name": "Profile",
          "description": "Its name in PlayGuard."
        }
      }
    },
    "stop_today": {
      "name": "No more play today",
      "description": "0 minutes today; the usual limit comes back tomorrow.",
      "fields": {
        "device_id": {
          "name": "Console",
          "description": "The console."
        }
      }
    },
    "lock_now": {
      "name": "Lock now",
      "description": "Locks parental controls again after a temporary unlock.",
      "fields": {
        "device_id": {
          "name": "Console",
          "description": "The console."
        }
      }
    },
    "sync_now": {
      "name": "Sync now",
      "description": "The console publishes everything again.",
      "fields": {
        "device_id": {
          "name": "Console",
          "description": "The console."
        }
      }
    },
    "request_report": {
      "name": "Request a diagnostic report",
      "description": "The console saves a report on its SD card, and publishes it when Remote access allows it (then in the device's diagnostics).",
      "fields": {
        "device_id": {
          "name": "Console",
          "description": "The console."
        }
      }
    }
